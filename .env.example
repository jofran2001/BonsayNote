# String de conexão do MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.xxxxx.mongodb.net/bonsai-diary?retryWrites=true&w=majority

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=bonsai_diary_super_secret_key_change_in_production

# Login Social Google (OAuth 2.0 Client ID do Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com

# Opcional: Configuração Cloudinary para upload externo de imagens (se omitido, usa Base64 otimizado diretamente)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
